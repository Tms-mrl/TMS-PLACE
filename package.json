{
  "name": "elmuelle-places",
  "version": "0.0.1",
  "private": true,
  "description": "El Muelle Places — gestión inmobiliaria + marketplace público de propiedades (standalone, ex-CoopenPlaces)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc -p src/worker && tsc -p src/client",
    "db:migrate:local": "node scripts/migrate-d1.mjs --local",
    "db:migrate:remote": "node scripts/migrate-d1.mjs --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "~4.85.0"
  }
}
